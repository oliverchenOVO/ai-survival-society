{
  "name": "ai-survival-society",
  "version": "1.7.0",
  "private": true,
  "description": "A living 3D society of autonomous agents, with utility AI and optional local language models.",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.mjs",
    "build": "vite build",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs && npm run test:benchmark",
    "test:benchmark": "node scripts/benchmark-spatial.mjs",
    "test:results": "node scripts/qa-results.mjs",
    "test:simulation": "node scripts/validate-simulation.mjs",
    "test:ui": "node scripts/qa-browser.mjs",
    "test:i18n": "node scripts/qa-localization.mjs",
    "desktop": "electron .",
    "build:desktop": "npm run build && electron-builder --win --dir",
    "build:portable": "npm run build && electron-builder --win portable",
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-assets.ps1",
    "test:desktop": "node scripts/qa-desktop.mjs",
    "demo:video": "node scripts/demo-video.mjs",
    "test:story": "node scripts/qa-stories.mjs",
    "test:story:desktop": "node scripts/qa-stories.mjs --desktop",
    "test:visual": "node scripts/qa-physical-world.mjs",
    "test:spatial": "node --test tests/spatial.test.mjs tests/vertical.test.mjs",
    "test:navigation": "node --test tests/spatial.test.mjs tests/vertical.test.mjs",
    "test:collision": "node --test tests/spatial.test.mjs tests/vertical.test.mjs"
  },
  "dependencies": {
    "delaunator": "^5.1.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.9",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.oliver.survivalsociety",
    "productName": "AI Survival Society",
    "directories": {
      "output": "builds"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "server/**/*",
      "core/**/*",
      "config/**/*",
      "src/i18n/*.mjs",
      "package.json",
      "src/story/*.mjs",
      "public/assets/world-collision.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "AI-Survival-Society-${version}.${ext}",
      "icon": "desktop/icon.ico",
      "signExecutable": false
    },
    "asar": false,
    "portable": {
      "unpackDirName": true
    }
  },
  "author": "Oliver"
}
