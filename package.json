{
  "name": "ai-survival-society",
  "version": "1.0.0",
  "private": true,
  "description": "A living 3D society of autonomous agents, with utility AI and optional local language models.",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:simulation": "node scripts/validate-simulation.mjs",
    "test:ui": "node scripts/qa-browser.mjs",
    "desktop": "electron .",
    "build:desktop": "npm run build && electron-builder --win --dir",
    "build:portable": "npm run build && electron-builder --win portable",
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-assets.ps1"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.55.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.oliver.survivalsociety",
    "productName": "AI Survival Society",
    "directories": { "output": "builds" },
    "files": ["dist/**/*", "desktop/**/*", "server/**/*", "core/**/*", "config/**/*", "package.json"],
    "win": { "target": ["portable"], "artifactName": "AI-Survival-Society-${version}.${ext}" },
    "asar": true
  }
}
